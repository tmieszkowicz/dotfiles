  "tokenColors": [
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "storage",
        "storage.modifier",
        "variable.language"
      ],
      "settings": { "foreground": "#aa88cb" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ffdd80" }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.function-call",
        "entity.name.method",
        "entity.name.function.member"
      ],
      "settings": { "foreground": "#7ec8f7" }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.parameter"
      ],
      "settings": { "foreground": "#e899d4" }
    },
    {
      "name": "Variables & Properties",
      "scope": [
        "variable",
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "variable.object.property"
      ],
      "settings": { "foreground": "#edecee" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#dca561" }
    },
    {
      "name": "Storage type (dim)",
      "scope": ["storage.type"],
      "settings": { "foreground": "#555566" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string.template"
      ],
      "settings": { "foreground": "#82ffd3" }
    },
    {
      "name": "Template Expression",
      "scope": ["meta.template.expression"],
      "settings": { "foreground": "#edecee" }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": { "foreground": "#6be5fd" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#e15d97" }
    },
    {
      "name": "Tag Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#a8c8e8" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#ffffff33" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6d6d6d" }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": { "foreground": "#aa88cb" }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#82ffd3" }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#e15d97", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffdd80", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#aa88cb", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Link",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#7ec8f7" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown"],
      "settings": { "foreground": "#82ffd3" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#81b88b" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#c74e39" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#7ec8f7" }
    }
  ],

  "semanticTokenColors": {
    "variable": "#edecee",
    "variable.readonly": "#edecee",
    "parameter": "#dca561",
    "property": "#edecee",
    "field": "#edecee",
    "field.static": "#dca561",
    "method": "#7ec8f7",
    "function": "#7ec8f7",
    "member": "#7ec8f7",
    "class": "#e899d4",
    "struct": "#e899d4",
    "interface": "#e899d4",
    "enum": "#e899d4",
    "type": "#e899d4",
    "delegate": "#e899d4",
    "typeParameter": "#a8c8e8",
    "namespace": "#888899",
    "enumMember": "#6be5fd",
    "event": "#aa88cb",
    "keyword": "#aa88cb",
    "modifier": "#aa88cb",
    "string": "#82ffd3",
    "number": "#6be5fd",
    "operator": "#ffdd80",
    "comment": "#6d6d6d"
  }
}
