      "settings": {
        "foreground": "#82ffd3"
      }
    },
    {
      "name": "CSS Pseudo Element",
      "scope": ["entity.other.attribute-name.pseudo-element.css"],
      "settings": {
        "foreground": "#ffaffc"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
