  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#666666"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#82ffd3"
      }
    },
    {
      "name": "String Template",
      "scope": ["string.template", "punctuation.definition.string.template"],
      "settings": {
        "foreground": "#82ffd3"
      }
    },
    {
      "name": "Template Expression",
      "scope": ["meta.template.expression"],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "keyword.other.unit"],
      "settings": {
        "foreground": "#82f8fc"
      }
    },
    {
      "name": "Built-in constant",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#ffbd83"
      }
    },
    {
      "name": "User-defined constant",
      "scope": ["constant.character", "constant.other"],
      "settings": {
        "foreground": "#ffbd83"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": {
        "foreground": "#c389d5"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#ffbd83"
      }
    },
    {
      "name": "Keyword Operator Logical",
      "scope": ["keyword.operator.logical"],
      "settings": {
        "foreground": "#c389d5"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#ff81e6"
      }
    },
    {
      "name": "Storage type",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#888899"
      }
    },
    {
      "name": "Storage Modifier",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#ff81e6"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable"],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Variable Language",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#ff81e6"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#dca561"
      }
    },
    {
      "name": "Variable Property",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Function name",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Function call",
      "scope": ["meta.function-call", "entity.name.function-call"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Method",
      "scope": ["entity.name.method", "entity.name.function.member"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Class name",
      "scope": ["entity.name.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#8db9e2"
      }
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "foreground": "#8db9e2"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Type Parameter",
      "scope": ["entity.name.type.parameter"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Library class/type",
      "scope": ["support.class"],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "Library constant",
      "scope": ["support.constant"],
      "settings": {
        "foreground": "#6be5fd"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#ffffff57"
      }
    },
    {
      "name": "Punctuation Definition",
      "scope": ["punctuation.definition"],
      "settings": {
        "foreground": "#ffffff57"
      }
    },
    {
      "name": "Punctuation Separator",
      "scope": ["punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#ffffff57"
      }
    },
    {
      "name": "Tag name",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#e15d97"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ffaffc"
      }
    },
    {
      "name": "Tag Punctuation",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#e15d97"
      }
    },
    {
      "name": "JSON Property Name",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#bb8ee7"
      }
    },
    {
      "name": "JSON String Value",
      "scope": [
        "meta.structure.dictionary.value.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#82ffd3"
      }
    },
    {
      "name": "JSON Number",
      "scope": ["constant.numeric.json"],
      "settings": {
        "foreground": "#82f8fc"
      }
    },
    {
      "name": "JSON Boolean",
      "scope": ["constant.language.json"],
      "settings": {
        "foreground": "#ffbd83"
      }
    },
    {
      "name": "JSON Null",
      "scope": ["constant.language.null.json"],
      "settings": {
        "foreground": "#ff81e6"
      }
    },
    {
      "name": "JSON Punctuation",
      "scope": [
        "punctuation.support.type.property-name.begin.json",
        "punctuation.support.type.property-name.end.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.dictionary.pair.json",
        "punctuation.separator.array.json",
        "punctuation.definition.dictionary.begin.json",
        "punctuation.definition.dictionary.end.json",
        "punctuation.definition.array.begin.json",
        "punctuation.definition.array.end.json"
      ],
      "settings": {
        "foreground": "#ffffff57"
      }
