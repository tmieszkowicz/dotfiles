{
    "workbench.colorTheme": "Aura Dracula Spirit (Soft)",
    "workbench.activityBar.location": "hidden",
    "workbench.editor.showTabs": "none",
    "workbench.statusBar.visible": false,
    "window.menuBarVisibility": "hidden",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": false,
    "workbench.sideBar.location": "right",
    "workbench.iconTheme": "charmed-icons",
    "material-icon-theme.hidesExplorerArrows": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.indent": 8,
    "explorer.compactFolders": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "explorer.decorations.badges": false,
    "git.decorations.enabled": true,
    "window.zoomLevel": 1,

    "window.titleBarStyle": "custom",
    "window.customTitleBarVisibility": "windowed",
    "window.commandCenter": false,
    "window.title": "${activeRepositoryBranchName}  >  ${activeEditorMedium} ${dirty}",

    "editor.fontFamily": "FiraCode Nerd Font",
    "editor.cursorBlinking": "solid",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,

    "editor.stickyScroll.enabled": false,
    "editor.colorDecorators": false,
    "editor.codeLens": false,
    "editor.links": false,
    "editor.matchBrackets": "never",
    "editor.parameterHints.enabled": false,
    "editor.lightbulb.enabled": "off",
    "editor.hover.enabled": "off",
    "editor.lineNumbers": "relative",
    "editor.renderLineHighlight": "none",
    "editor.occurrencesHighlight": "off",
    "editor.selectionHighlight": false,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.tabCompletion": "on",

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.autoSave": "afterDelay",
    "extensions.ignoreRecommendations": true,

    "files.exclude": {
        "**/.gitignore": true,
        "**/.vscode": true,
        "**/bin": true,
        "**/obj": true
    },

    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "chat.agent.enabled": false,

    "custom-ui-style.stylesheet": {
        ".notification-toast": "box-shadow: none !important",
        ".quick-input-widget": "top: 25vh !important; box-shadow: none !important",
        ".quick-input-list .scrollbar": "display: none",
        ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
        ".monaco-scrollable-element > .shadow.top": "display: none",
        ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #ffaffc 10%, #DA70D6 100%)",
        ".window-appicon": "display: none !important",
        ".menubar-menu-title": "font-family: 'FiraCode Nerd Font' !important",
        ".window-title": "font-family: 'FiraCode Nerd Font' !important; font-weight: 400 !important",
        ".suggest-widget": "font-family: 'FiraCode Nerd Font' !important; border: none !important; box-shadow: none !important",
        ".title-actions": "display: none !important",
        ".section-header .actions": "display: none !important",
        ".pane-header .actions": "display: none !important",
    },

    "workbench.colorCustomizations": {
        "focusBorder" : "#1c1b22",
        "editor.background": "#1c1b22",
        "sideBar.background": "#1c1b22",
        "activityBar.background": "#1c1b22",
        "titleBar.activeBackground": "#1c1b22",
        "titleBar.inactiveBackground": "#1c1b22",
        "statusBar.background": "#1c1b22",
        "editorGroupHeader.tabsBackground": "#1c1b22",
        "terminal.background" :"#1c1b22",

        "editorSuggestWidget.background": "#1c1b22",
        "editorSuggestWidget.border": "#00000000",
        "editorSuggestWidget.selectedBackground": "#4d4b59",
        "editorSuggestWidget.focusHighlightForeground": "#ffaffc",
        "input.background": "#1c1b22",
        "input.border": "#00000000",

        "editorGroup.border": "#1c1b22",
        "sideBar.border": "#1c1b22",
        "editorWidget.border": "#00000000",
        "contrastBorder": "#00000000",

        "editorOverviewRuler.border": "#0000",
        "editorOverviewRuler.modifiedForeground": "#0000",
        "editorOverviewRuler.addedForeground": "#0000",
        "editorOverviewRuler.errorForeground": "#0000",
        "editorOverviewRuler.warningForeground": "#0000",

        "panel.border": "#1c1b22",
        "panel.background": "#1c1b22"
    }
}
