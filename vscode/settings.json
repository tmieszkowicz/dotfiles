{
  // --- Workbench & Window Layout ---
  "workbench.colorTheme": "Wiqht",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "window.zoomLevel": 1,
  "workbench.iconTheme": "charmed-warm",

  // --- Global Feature Toggles & Privacy ---
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "chat.agent.enabled": false,
  "extensions.ignoreRecommendations": true,

  // --- UI Visibility ---
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.statusBar.visible": false,
  "window.menuBarVisibility": "hidden",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,

  // --- Custom Title Bar ---
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "windowed",
  "window.title": "${activeRepositoryBranchName}  >  ${activeEditorMedium} ${dirty}",

  // --- Typography ---
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontSize": 14,
  "editor.lineHeight": 19,
  "editor.fontLigatures": true,
  "editor.codeLensFontFamily": "FiraCode Nerd Font",
  "editor.inlayHints.fontFamily": "FiraCode Nerd Font",
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "scm.inputFontFamily": "FiraCode Nerd Font",
  "chat.editor.fontFamily": "FiraCode Nerd Font",
  "debug.console.fontFamily": "FiraCode Nerd Font",
  "notebook.output.fontFamily": "FiraCode Nerd Font",
  "markdown.preview.fontFamily": "FiraCode Nerd Font",

  // --- Editor Behavior & Rendering ---
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "solid",
  "editor.tabCompletion": "on",
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": false,
  "editor.matchBrackets": "never",
  "editor.lightbulb.enabled": "off",
  "editor.hover.enabled": "off",
  "editor.glyphMargin": true,
  // "editor.parameterHints.enabled": false,
  "editor.showFoldingControls": "never",
  "editor.renderWhitespace": "none",
  "editor.guides.indentation": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.colorDecorators": false,
  "editor.codeLens": false,
  "editor.links": false,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.terminal.kill",
    "workbench.action.closePanel"
  ],

  // --- File Explorer & Sidebar ---
  "workbench.sideBar.location": "right",
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  // "explorer.decorations.badges": false,
  // "git.decorations.enabled": false,
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.enableStickyScroll": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // --- File Saving & Exclusions ---
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.gitignore": true,
    "**/.vscode": true,
    "**/bin": true,
    "**/obj": true
  },

  // --- Extension Specifics ---
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  // --- Custom UI CSS  ---
  "custom-ui-style.stylesheet": {
    ".notification-toast": "box-shadow: none !important",
    ".quick-input-widget": "top: 25vh !important; box-shadow: none !important",
    ".quick-input-list .scrollbar": "display: none",
    ".monaco-workbench .part.editor > .content .editor-group-container > .title.title-border-bottom:after": "display: none",
    ".monaco-scrollable-element": "font-family : 'FiraCode Nerd Font' !important; font-size : 11px",
    ".monaco-scrollable-element > .shadow.top": "display: none",
    ".monaco-editor .scroll-decoration": "display: none !important",
    ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #ffaffc 10%, #DA70D6 100%)",
    ".window-appicon": "display: none !important",
    ".menubar-menu-title": "font-family: 'FiraCode Nerd Font' !important",
    ".window-title": "font-family: 'FiraCode Nerd Font' !important; font-weight: 400 !important",
    ".suggest-widget": "font-family: 'FiraCode Nerd Font' !important; border: none !important; box-shadow: none !important",
    ".title-actions": "display: none !important",
    ".section-header .actions": "display: none !important",
    ".pane-header .actions": "display: none !important"
  }
}
